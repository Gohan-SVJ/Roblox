local TweenService = game:GetService("TweenService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

-- Hyundai Future Adventure place ID
local PLACE_ID = 13457104744

-- HIGHER = FASTER
local SPEED = 350

-- TELEPORT TO EVENT FIRST
local args = {
	"teleport_SeasonEvent",
	"Obby"
}

ReplicatedStorage
	:WaitForChild("RemoteMessenger")
	:WaitForChild("SendData")
	:FireServer(unpack(args))

print("Teleporting to Obby...")

task.wait(5)

-- CHARACTER
local function getCharacter()
	local character = player.Character or player.CharacterAdded:Wait()
	local hrp = character:WaitForChild("HumanoidRootPart")
	local humanoid = character:WaitForChild("Humanoid")
	return character, hrp, humanoid
end

local character, hrp, humanoid = getCharacter()

player.CharacterAdded:Connect(function()
	character, hrp, humanoid = getCharacter()
end)

-- FAST SAFE TWEEN
local function tweenTo(position)
	repeat
		if not character or not hrp or humanoid.Health <= 0 then
			task.wait(1)
		else
			local targetCF = CFrame.new(position + Vector3.new(0, 3, 0))

			local distance = (hrp.Position - targetCF.Position).Magnitude
			local time = math.clamp(distance / SPEED, 0.08, 3)

			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero

			local tween = TweenService:Create(
				hrp,
				TweenInfo.new(time, Enum.EasingStyle.Linear),
				{
					CFrame = targetCF
				}
			)

			tween:Play()

			local reached = false

			local connection
			connection = tween.Completed:Connect(function()
				reached = true
				connection:Disconnect()
			end)

			repeat
				task.wait()

				if hrp then
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.AssemblyAngularVelocity = Vector3.zero
				end

				if humanoid.Health <= 0 then
					tween:Cancel()
					break
				end

			until reached

			if reached then
				hrp.CFrame = targetCF
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
				break
			end
		end
	until false
end

-- WAIT FOR TICKETS
local folder = workspace:WaitForChild("SpinTicketFolder")

local tickets = folder:GetChildren()

table.sort(tickets, function(a, b)
	return a.Name < b.Name
end)

-- COLLECT TICKETS
for _, obj in ipairs(tickets) do
	local targetPos

	if obj:IsA("Model") then
		targetPos = obj:GetPivot().Position
	elseif obj:IsA("BasePart") then
		targetPos = obj.Position
	end

	if targetPos then
		print("Going to:", obj.Name)
		tweenTo(targetPos)
		task.wait(0.2)
	end
end

print("Finished all tickets")

-- TELEPORT BACK
TeleportService:Teleport(PLACE_ID, player)
