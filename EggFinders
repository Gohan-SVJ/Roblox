local MAX_DISTANCE = 600

local function findPriorityEgg()

    local eggsFolder =
        workspace:FindFirstChild("Eggs")

    if not eggsFolder then
        return nil
    end

    for _, rarity in ipairs(PriorityOrder) do

        local bestEgg
        local bestDistance = math.huge

        for _, eggName in ipairs(
            PriorityEggs[rarity]
        ) do

            for _, egg in ipairs(
                eggsFolder:GetChildren()
            ) do

                if egg.Name == eggName then

                    local distance =
                        (hrp.Position -
                        egg:GetPivot().Position).Magnitude

                    if distance <= 600
                        and distance < bestDistance then

                        bestDistance = distance
                        bestEgg = egg
                    end
                end
            end
        end

        if bestEgg then
            return bestEgg, rarity
        end
    end

    return nil
end

local function getHigherPriorityEgg(
    currentRarity
)

    local currentValue =
        PriorityValue[currentRarity]

    local egg, rarity =
        findPriorityEgg()

    if egg
        and PriorityValue[rarity]
        > currentValue then

        return egg, rarity
    end

    return nil
end

local function moveToPriorityEgg(
    egg,
    rarity
)

    local start = tick()

    while tick() - start < 15 do

        if not priorityEggActive then
            return false
        end

        if not egg.Parent then
            return false
        end

        local position =
            egg:GetPivot().Position

        humanoid:MoveTo(position)

        local distance =
            (hrp.Position - position).Magnitude

        if distance <= 2.5 then

            humanoid:MoveTo(
                hrp.Position
            )

            return true
        end

        local betterEgg,
              betterRarity =
            getHigherPriorityEgg(
                rarity
            )

        if betterEgg then

            print(
                "[Priority Egg] Upgrade:",
                egg.Name,
                "->",
                betterEgg.Name
            )

            egg = betterEgg
            rarity = betterRarity

            start = tick()
        end

        task.wait(0.1)
    end

    return false
end

local function priorityEggLoop()

    if priorityRunning then
        return
    end

    priorityRunning = true

    while priorityEggActive do

        task.wait(0.1)

        if not refreshCharacter() then
            continue
        end

        local egg, rarity =
            findPriorityEgg()

        if not egg then

            pauseAutoRaise = false

            continue
        end

        pauseAutoRaise = true

        print(
            "[Priority Egg] Found:",
            egg.Name,
            "|",
            rarity
        )

        local reached =
            moveToPriorityEgg(
                egg,
                rarity
            )

        if not reached then

            pauseAutoRaise = false

            continue
        end

        local clickDetector =
            egg:FindFirstChildOfClass(
                "ClickDetector"
            )

        if clickDetector then

            fireclickdetector(
                clickDetector
            )

            print(
                "[Priority Egg] Clicked:",
                egg.Name
            )
        end

        task.wait(0.3)

        local indicator =
            workspace.World2
            .Index
            :FindFirstChild(
                "Indicator"
            )

        if indicator then

            local targetPosition =
                indicator:GetPivot()
                .Position

            humanoid:MoveTo(
                targetPosition
            )

            repeat

                task.wait(0.1)

            until
                (hrp.Position -
                targetPosition).Magnitude <= 4
                or not priorityEggActive
        end

        print(
            "[Priority Egg] Reached Indicator"
        )

        pauseAutoRaise = false

        task.wait(0.5)
    end

    priorityRunning = false
end

