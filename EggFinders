local function isCommonEgg(name)
    for _, eggName in ipairs(CommonEggs) do
        if eggName == name then
            return true
        end
    end
    return false
end

local function getNearestEgg()
    local eggsFolder = workspace:FindFirstChild("Eggs")
    if not eggsFolder then
        return nil
    end

    local nearest
    local nearestDist = math.huge

    for _, egg in ipairs(eggsFolder:GetChildren()) do
        if isCommonEgg(egg.Name) then
            local dist = (hrp.Position - egg:GetPivot().Position).Magnitude

            if dist < nearestDist then
                nearestDist = dist
                nearest = egg
            end
        end
    end

    return nearest
end

local function pathfindTo(destination, reachDistance)
    reachDistance = reachDistance or 4

    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = true
    })

    local success = pcall(function()
        path:ComputeAsync(hrp.Position, destination)
    end)

    if not success then
        return false
    end

    if path.Status ~= Enum.PathStatus.Success then
        return false
    end

    local waypoints = path:GetWaypoints()

    for _, waypoint in ipairs(waypoints) do

        if not autoRaiseActive then
            return false
        end

        humanoid:MoveTo(waypoint.Position)

        if waypoint.Action == Enum.PathWaypointAction.Jump then
            humanoid.Jump = true
        end

        local reached = false

        local conn
        conn = humanoid.MoveToFinished:Connect(function(success)
            reached = true
        end)

        local startTime = tick()

        repeat
            task.wait()

            if (hrp.Position - destination).Magnitude <= reachDistance then
                conn:Disconnect()
                return true
            end

        until reached or tick() - startTime > 3

        conn:Disconnect()
    end

    return (hrp.Position - destination).Magnitude <= reachDistance
end

local function activateStatue()
    local statue = workspace:FindFirstChild("StatueBlessing")
    if not statue then
        return
    end

    local statueHRP = statue:FindFirstChild("HumanoidRootPart")
    if not statueHRP then
        return
    end

    local pp = statueHRP:FindFirstChild("ProximityPrompt")
    if not pp then
        return
    end

    print("Moving to statue...")

    local reached = pathfindTo(
        statueHRP.Position,
        math.max(2, pp.MaxActivationDistance - 1)
    )

    if not reached then
        warn("Failed to reach statue")
        return
    end

    local distance = (hrp.Position - statueHRP.Position).Magnitude

    print("Distance To Statue:", distance)

    if distance <= pp.MaxActivationDistance then
        print("Fire Prompt")
        fireproximityprompt(pp)
    end
end

local function autoRaiseLoop()
    while autoRaiseActive do

        refreshCharacter()

        local egg = getNearestEgg()

        if not egg then
            task.wait(0.5)
            continue
        end

        print("Target Egg:", egg.Name)

        local eggPos = egg:GetPivot().Position

        local reachedEgg = pathfindTo(eggPos, 4)

        if not reachedEgg then
            warn("Failed to reach egg")
            task.wait(0.5)
            continue
        end

        local cd = egg:FindFirstChildOfClass("ClickDetector")

        if cd then
            fireclickdetector(cd)
            print("Egg Clicked")
        end

        task.wait(0.2)

        activateStatue()

        task.wait(0.2)
    end
end

