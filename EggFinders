    local statueHRP =
        statue:FindFirstChild("HumanoidRootPart")

    if not statueHRP then
        return false
    end

    local pp =
        statueHRP:FindFirstChild("ProximityPrompt")

    if not pp then
        return false
    end

    print("===== STATUE PHASE =====")

    humanoid:MoveTo(statueHRP.Position)

    local lastDistance = math.huge

    while CarryingEgg
        and autoRaiseActive
        and not pauseAutoRaise do

        local distance =
            (hrp.Position -
            statueHRP.Position).Magnitude

        if math.abs(distance - lastDistance) > 10 then

            print(
                "Distance To Statue:",
                math.floor(distance)
            )

            lastDistance = distance
        end

        if distance <= pp.MaxActivationDistance then

            humanoid:MoveTo(hrp.Position)

            print("In range -> Fire Prompt")

            fireproximityprompt(pp)

            CarryingEgg = false
            LastCollectedEgg = nil

            return true
        end

        -- chỉ MoveTo lại nếu bị đứng yên
        if humanoid.MoveDirection.Magnitude < 0.05 then

            humanoid:MoveTo(
                statueHRP.Position
            )

        end

        task.wait(0.1)
    end

    return false
end

