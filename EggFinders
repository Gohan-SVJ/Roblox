            frame.BackgroundTransparency = 0
            frame.ZIndex = 10
            frame.Parent = Gui

            local label = Instance.new("TextLabel")
            label.Name = "RarityLabel"
            label.AnchorPoint = Vector2.new(0.5, 0)
            label.BackgroundTransparency = 1
            label.Size = UDim2.new(0, 140, 0, 16)
            label.Font = Enum.Font.SourceSansBold
            label.TextSize = 14
            label.TextStrokeTransparency = 0.5
            label.Text = ""
            label.ZIndex = 11
            label.Parent = Gui

            return {Line = frame, Label = label}
        end

        local function SetTracer(tracer, origin, dest, color, text)
            local midpoint = (origin + dest) / 2
            local length = (origin - dest).Magnitude

            tracer.Line.Position = UDim2.new(0, midpoint.X, 0, midpoint.Y)
            tracer.Line.Size = UDim2.new(0, length, 0, 2)
            tracer.Line.Rotation = math.deg(math.atan2(dest.Y - origin.Y, dest.X - origin.X))
            tracer.Line.BackgroundColor3 = color
            tracer.Line.Visible = true

            tracer.Label.Position = UDim2.new(0, dest.X, 0, dest.Y)
            tracer.Label.TextColor3 = color
            tracer.Label.Text = text
            tracer.Label.Visible = true
        end

