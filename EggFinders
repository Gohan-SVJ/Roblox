            if not torsoScreenPos or not torsoWorldPos then
                for i = 1, #DrawnObjects do
                    if DrawnObjects[i] then HideTracer(DrawnObjects[i]) end
                end
                return
            end

            local lineOrigin = ClampToScreen(torsoScreenPos, viewportSize)

            local Eggs = workspace:FindFirstChild("Eggs")
            if Eggs then
                for _, obj in pairs(Eggs:GetChildren()) do
                    local name = obj.Name
                    local rarity = GetRarity(name)
                    if rarity then
                        local meshPart = nil
                        if obj:IsA("Model") then
                            meshPart = obj:FindFirstChild("Main")
                        elseif obj:IsA("MeshPart") then
                            meshPart = obj
                        end

                        if meshPart then
                            -- Khoảng cách check
                            local dist = (meshPart.Position - torsoWorldPos).Magnitude
                            if dist > MAX_DISTANCE then continue end

                            -- Chỉ vẽ nếu egg thật sự trong camera view
                            local screenPos, onScreen = Camera:WorldToScreenPoint(meshPart.Position)
                            if not onScreen then continue end

                            local destPos = Vector2.new(screenPos.X, screenPos.Y)

                            activeCount += 1
                            if not DrawnObjects[activeCount] then
                                DrawnObjects[activeCount] = CreateTracer()
                            end

                            local tracer = DrawnObjects[activeCount]
                            local color = RarityColors[rarity]
                            local distLabel = " [" .. math.floor(dist) .. "]"
                            SetTracer(tracer, lineOrigin, destPos, color, rarity .. distLabel)
                        end
                    end
                end
            end

            -- Ẩn tracer không dùng
            for i = activeCount + 1, #DrawnObjects do
                if DrawnObjects[i] then HideTracer(DrawnObjects[i]) end
            end
        end)

    else
        if RenderConnection then
            RenderConnection:Disconnect()
            RenderConnection = nil
        end
        for _, obj in pairs(DrawnObjects) do
            if obj and obj.Line then obj.Line:Destroy() end
            if obj and obj.Label then obj.Label:Destroy() end
        end
        DrawnObjects = {}
        if Gui then Gui:Destroy() Gui = nil end
