local function isTakenEgg(egg)

    if egg == LastCollectedEgg then
        return true
    end

    if egg:FindFirstChildWhichIsA("RopeConstraint", true) then
        return true
    end

    return false
end

local function getNearestEgg()

    local eggsFolder = workspace:FindFirstChild("Eggs")

    if not eggsFolder then
        return nil
    end

    for _, rarity in ipairs(RaiseOrder) do

        local bestEgg
        local bestDistance = math.huge

        for _, eggName in ipairs(RaiseEggs[rarity]) do

            for _, egg in ipairs(eggsFolder:GetChildren()) do

                if egg.Name == eggName
                and not isTakenEgg(egg) then

                    local distance =
                        (hrp.Position - egg:GetPivot().Position).Magnitude

                    if distance <= 600
                    and distance < bestDistance then

                        bestDistance = distance
                        bestEgg = egg
                    end
                end
            end
        end

        if bestEgg then

            print(
                "[Auto Raise]",
                rarity,
                bestEgg.Name,
                math.floor(bestDistance) .. " studs"
            )

            return bestEgg
        end
    end

    return nil
end

local function walkTo(position, threshold, timeout)

    threshold = threshold or 4
    timeout = timeout or 8

    local start = tick()

    while tick() - start < timeout do

        humanoid:MoveTo(position)

        local dist =
            (hrp.Position - position).Magnitude

        if dist <= threshold then

            humanoid:MoveTo(hrp.Position)

            return true
        end

        task.wait(0.15)
    end

    humanoid:MoveTo(hrp.Position)

    return false
end

local function activateStatue()

