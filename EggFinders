local function GetTorsoScreenPos()
    local char = Players.LocalPlayer.Character
    if not char then return nil, nil end
    local torso = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    if not torso then return nil, nil end
    local screenPos, onScreen = Camera:WorldToScreenPoint(torso.Position)
    if not onScreen then return nil, nil end
    return Vector2.new(screenPos.X, screenPos.Y), torso.Position
end

local function ClampToScreen(pos, viewportSize)
    return Vector2.new(
        math.clamp(pos.X, 0, viewportSize.X),
        math.clamp(pos.Y, 0, viewportSize.Y)
    )
end

